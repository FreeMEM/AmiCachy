# Base system
base
linux-cachyos
# linux-cachyos-headers intentionally omitted from the live image: nothing
# at runtime needs them (nvidia-open-dkms's module is already compiled
# into the squashfs at pacstrap time), they cost ~160 MB, and a live ISO
# never recompiles modules. The installer adds them back on a `pacman -S`
# to disk so post-install kernel updates can rebuild DKMS modules.
#
# linux-firmware split (Arch ~2025-Q4) no longer ships GPU/Wi-Fi blobs in the
# base package — RTX 2000/3000/4000 (Turing/Ampere/Ada) require GSP firmware
# from linux-firmware-nvidia or nouveau hangs the boot. Enumerate all
# consumer-hardware splits to restore the old "full" coverage; skip the
# enterprise-only ones (liquidio/mellanox/nfp/qlogic = fibre/InfiniBand).
linux-firmware
linux-firmware-amdgpu
linux-firmware-atheros
linux-firmware-broadcom
linux-firmware-cirrus
linux-firmware-intel
linux-firmware-marvell
linux-firmware-mediatek
linux-firmware-nvidia
linux-firmware-other
linux-firmware-qcom
linux-firmware-radeon
linux-firmware-realtek
mkinitcpio
mkinitcpio-archiso
syslinux

# Bootloader (bootctl is part of systemd, included in base)
efibootmgr

# Filesystem
btrfs-progs
dosfstools
e2fsprogs
ntfs-3g
exfatprogs
# Intel RST / RAID (Mac/PC SSDs)
dmraid
mdadm
lvm2

# Network (minimal for live env)
networkmanager
iwd
dhcpcd
iw
wireless-regdb
# broadcom-wl-dkms + linux-cachyos-headers (~165 MB combined) intentionally
# omitted from the live: broadcom-wl is only useful for the old BCM4360
# Wi-Fi (MacBook 2013-2015), and DKMS needs the headers at build time,
# which the live cannot do. Users on those machines can `pacman -S
# broadcom-wl-dkms linux-cachyos-headers` after installing to disk.

# Wayland compositors (wlroots pulled as dependency of cage/labwc)
cage
labwc
xorg-xwayland

# Wayland desktop utilities
waybar
foot
fuzzel
mako
grim
slurp
wl-clipboard

# Audio
pipewire
pipewire-pulse
pipewire-alsa
wireplumber

# Graphics drivers (broad support)
mesa
vulkan-radeon
vulkan-intel
# NVIDIA proprietary stack — kernel module is MIT/GPL (nvidia-open-dkms,
# Turing+/RTX 20xx+ supported), but nvidia-utils (libGL/libEGL/Vulkan ICD)
# stays under NVIDIA's EULA — redistribution-clean (LICENSE shipped under
# /usr/share/licenses/nvidia/). nouveau is masked at boot (cmdline +
# mkinitcpio) so this driver wins; on systems without an NVIDIA card the
# package is dead weight (~500 MB) but the iGPU still drives the display.
# vulkan-nouveau is intentionally absent — it conflicts with the NVIDIA
# ICD and we have no use for it once nouveau is blacklisted.
nvidia-open-dkms
nvidia-utils
egl-wayland
libva-nvidia-driver
vulkan-icd-loader
intel-media-driver
xf86-video-amdgpu

# Amiberry runtime dependencies
sdl2
sdl2_image
sdl2_ttf
libmpeg2
libpng
zlib
flac
mpg123
libserialport
portmidi
enet
tinyxml2
gnu-free-fonts

# fs-uae intentionally absent: the FS-UAE+RTG path was needed to host the
# AROS Vision bundle, but DOS3 filesystem tooling on Linux is too
# limiting to ship that bundle properly (see asset-catalog.json
# _fsuae_attempt_outcome). All current bundles run on Amiberry+AGA.

# GUI runtime — installer, early-startup menu, asset fetcher and
# hardware audit are all PySide6/Qt apps. `code` is for the Dev Station
# profile only; if you don't ship that profile, drop it to save ~530 MB.
code
python
pyside6
qt6-wayland

# System tools (git intentionally omitted: 0 runtime references; only
# the build host needs it)
htop
nano
bash-completion
man-db
sudo
openssh
terminus-font

# Disk automount (USB drives, internal SSDs)
udisks2
udiskie
polkit

# Boot splash
plymouth

# Installer & audit dependencies
parted
gptfdisk
arch-install-scripts

# Calamares installer (LIVE ONLY — Calamares migration, F3). cachyos-calamares
# is the engine + standard modules; calamares-config-amicachy (local repo)
# ships our settings.conf, branding and the amicachy-postinstall job. Neither
# is installed into the target: the installed system is deployed from the
# separate clean squashfs built by tools/build_target_rootfs.sh.
cachyos-calamares
calamares-config-amicachy

# Persistent partition filesystem support (Windows-friendly options)
ntfs-3g
exfatprogs
