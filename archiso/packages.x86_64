# Base system
base
linux-cachyos
# linux-firmware split (Arch ~2025-Q4) no longer ships GPU/Wi-Fi blobs in the
# base package — RTX 2000/3000/4000 (Turing/Ampere/Ada) require GSP firmware
# from linux-firmware-nvidia or nouveau hangs the boot. Enumerate all
# consumer-hardware splits to restore the old "full" coverage; skip the
# enterprise-only ones (liquidio/mellanox/nfp/qlogic = fibre/InfiniBand).
linux-firmware
linux-firmware-amdgpu
linux-firmware-atheros
linux-firmware-broadcom
linux-firmware-cirrus
linux-firmware-intel
linux-firmware-marvell
linux-firmware-mediatek
linux-firmware-nvidia
linux-firmware-other
linux-firmware-qcom
linux-firmware-radeon
linux-firmware-realtek
mkinitcpio
mkinitcpio-archiso
syslinux

# Bootloader (bootctl is part of systemd, included in base)
efibootmgr

# Filesystem
btrfs-progs
dosfstools
e2fsprogs
ntfs-3g
exfatprogs
# Intel RST / RAID (Mac/PC SSDs)
dmraid
mdadm
lvm2

# Network (minimal for live env)
networkmanager
iwd
dhcpcd
iw
wireless-regdb
# BCM4360 (MacBook) — broadcom-wl needs the kernel headers for DKMS
broadcom-wl-dkms
linux-cachyos-headers

# Wayland compositors (wlroots pulled as dependency of cage/labwc)
cage
labwc
xorg-xwayland

# Wayland desktop utilities
waybar
foot
fuzzel
mako
grim
slurp
wl-clipboard

# Audio
pipewire
pipewire-pulse
pipewire-alsa
wireplumber

# Graphics drivers (broad support)
mesa
vulkan-radeon
vulkan-intel
# NVIDIA proprietary stack — kernel module is MIT/GPL (nvidia-open-dkms,
# Turing+/RTX 20xx+ supported), but nvidia-utils (libGL/libEGL/Vulkan ICD)
# stays under NVIDIA's EULA — redistribution-clean (LICENSE shipped under
# /usr/share/licenses/nvidia/). nouveau is masked at boot (cmdline +
# mkinitcpio) so this driver wins; on systems without an NVIDIA card the
# package is dead weight (~500 MB) but the iGPU still drives the display.
# vulkan-nouveau is intentionally absent — it conflicts with the NVIDIA
# ICD and we have no use for it once nouveau is blacklisted.
nvidia-open-dkms
nvidia-utils
egl-wayland
libva-nvidia-driver
vulkan-icd-loader
intel-media-driver
xf86-video-amdgpu

# Amiberry runtime dependencies
sdl2
sdl2_image
sdl2_ttf
libmpeg2
libpng
zlib
flac
mpg123
libserialport
portmidi
enet
tinyxml2
gnu-free-fonts

# Alternative emulator (FS-UAE) — used for AROS bundles where Amiberry's
# Picasso96 driver hits a horizontal-tiling bug on cage+SDL2+Wayland.
fs-uae

# Development profile
code
python
pyside6
qt6-wayland

# System tools
htop
nano
git
bash-completion
man-db
sudo
openssh
terminus-font

# Disk automount (USB drives, internal SSDs)
udisks2
udiskie
polkit

# Boot splash
plymouth

# Installer & audit dependencies
parted
gptfdisk
arch-install-scripts

# Persistent partition filesystem support (Windows-friendly options)
ntfs-3g
exfatprogs
