#!/usr/bin/env bash
# AmiCachy — set the live-user password.
#
# sysusers.d creates 'amiga' with no password, so tty1's --autologin
# works but every other tty (or SSH) refuses entry. We need a known
# password for two real workflows:
#   1. Switching to a side tty (Ctrl-Alt-F3) to debug a hung session.
#   2. SSHing in from another machine to look at logs.
#
# 'amiga' is intentionally trivial — this is a live demo OS, not a
# server. The installer prompts for a real password on disk install.
#
# Idempotent: runs once on first boot (touches /etc/.amiga-pw-set) and
# never again, so a user who changed the password manually is not
# overwritten on a subsequent reboot of the live image.

set -u

MARKER="/etc/.amiga-pw-set"
[[ -f "$MARKER" ]] && exit 0

if ! id amiga >/dev/null 2>&1; then
    echo "amicachy-set-amiga-password: user 'amiga' does not exist yet" >&2
    exit 1
fi

if echo "amiga:amiga" | chpasswd; then
    touch "$MARKER"
    echo "amicachy-set-amiga-password: amiga user password set"
else
    echo "amicachy-set-amiga-password: chpasswd failed" >&2
    exit 1
fi
