#!/usr/bin/env bash
# Copy Amiga ROM/Kickstart files from the live USB into AmiCachy.

set -euo pipefail

ROM_PATTERNS=(
    "*.rom" "*.ROM"
    "*.key" "*.KEY"
    "*.bin" "*.BIN"
)

candidate_sources=(
    "/run/media/amiga"
    "/run/archiso/bootmnt"
    "/media"
    "/mnt"
)

print_header() {
    clear
    echo "AmiCachy ROM Copy Tool"
    echo "======================"
    echo
}

find_roms() {
    local source="$1"
    local expr=()
    local pattern

    for pattern in "${ROM_PATTERNS[@]}"; do
        if [[ ${#expr[@]} -gt 0 ]]; then
            expr+=(-o)
        fi
        expr+=(-iname "$pattern")
    done

    find "$source" -xdev -type f \( "${expr[@]}" \) 2>/dev/null
}

choose_source() {
    local sources=()
    local base entry

    for base in "${candidate_sources[@]}"; do
        [[ -d "$base" ]] || continue
        while IFS= read -r entry; do
            [[ -d "$entry" ]] && sources+=("$entry")
        done < <(find "$base" -mindepth 0 -maxdepth 2 -type d 2>/dev/null)
    done

    mapfile -t sources < <(printf '%s\n' "${sources[@]}" | awk '!seen[$0]++')

    echo "Source directories:"
    local i=1
    for entry in "${sources[@]}"; do
        echo "  $i) $entry"
        i=$((i + 1))
    done
    echo "  C) Custom path"
    echo
    read -r -p "Choose source [1]: " choice
    choice="${choice:-1}"

    if [[ "$choice" =~ ^[Cc]$ ]]; then
        read -r -p "Source path: " custom
        [[ -d "$custom" ]] || { echo "Not a directory: $custom" >&2; exit 1; }
        echo "$custom"
        return
    fi

    [[ "$choice" =~ ^[0-9]+$ ]] || { echo "Invalid choice." >&2; exit 1; }
    [[ "$choice" -ge 1 && "$choice" -le "${#sources[@]}" ]] || { echo "Invalid choice." >&2; exit 1; }
    echo "${sources[$((choice - 1))]}"
}

choose_destination() {
    local default_home="/home/amiga/kickstarts"
    local installed="/mnt/amicachy/home/amiga/kickstarts"

    echo
    echo "Destination:"
    echo "  1) Current live/dev user: $default_home"
    if [[ -d "/mnt/amicachy/home/amiga" ]]; then
        echo "  2) Mounted installed system: $installed"
    else
        echo "  2) Mounted installed system: $installed (not mounted yet)"
    fi
    echo "  C) Custom path"
    echo
    read -r -p "Choose destination [1]: " choice
    choice="${choice:-1}"

    case "$choice" in
        1) echo "$default_home" ;;
        2) echo "$installed" ;;
        [Cc])
            read -r -p "Destination path: " custom
            echo "$custom"
            ;;
        *) echo "Invalid choice." >&2; exit 1 ;;
    esac
}

copy_roms() {
    local source="$1"
    local destination="$2"
    local count=0
    local file dest_file

    mkdir -p "$destination"

    while IFS= read -r file; do
        dest_file="${destination}/$(basename "$file")"
        install -m 0644 "$file" "$dest_file"
        echo "Copied: $file -> $dest_file"
        count=$((count + 1))
    done < <(find_roms "$source")

    if [[ "$count" -eq 0 ]]; then
        echo "No ROM files found under: $source"
        exit 2
    fi

    chown -R amiga:amiga "$destination" 2>/dev/null || true
    echo
    echo "Done. Copied $count file(s) to $destination"
}

print_header
source_dir="$(choose_source)"
destination_dir="$(choose_destination)"
echo
copy_roms "$source_dir" "$destination_dir"
