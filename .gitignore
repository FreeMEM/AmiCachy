# Build artifacts
out/
work/
dev/*
!dev/dualboot-vm/
*.iso
*.img

# Generated by build_iso.sh from archiso/pacman-{generic,v3,v4}.conf
archiso/pacman.conf

# Bundled into the airootfs at build time and torn down by build_iso.sh's
# trap. Survives an interrupted build, so ignore unconditionally.
archiso/airootfs/usr/share/amicachy/tools/
archiso/airootfs/usr/share/amicachy/installer/

# Per-build local pacman repo assembled by build_iso.sh; cleaned by the
# same trap but stays around if the build is interrupted.
archiso/local-repo/

# Amiga ROMs and proprietary files
*.rom
*.ROM
kickstarts/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/

# Editor
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
