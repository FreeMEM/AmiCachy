# Maintainer: AmiCachy Project
# Based on AUR amiberry by Dimitris Panokostas, Chandler Kluser, Christer Solskogen
#
# AmiCachy build: optimized for CachyOS x86-64-v3 with LTO and DBUS control.
# The CachyOS makepkg.conf provides -march=x86-64-v3 -O3 via CFLAGS.
# We add LTO through CMake (WITH_LTO=ON) and disable makepkg's own LTO
# to avoid double -flto flags.
#
# v8.x changes from v7.x:
#   - SDL2 → SDL3 (+ SDL3_image replaces SDL2_image)
#   - sdl2_ttf removed (ImGui handles fonts natively)
#   - glew removed (OpenGL linked directly, crtemu no longer used in render path)
#   - New deps: nlohmann-json, curl, libpng
#   - ImGui-based GUI replaces legacy bitmap UI
#   - fix-opengl-build.patch dropped — to be re-evaluated against the new
#     opengl_renderer.cpp if the Wayland alpha bug reappears under cage/labwc

pkgname=amiberry
pkgver=8.1.5
pkgrel=6
pkgdesc="Optimized Amiga emulator — AmiCachy build (OpenGL, SDL3, ARCH-aware)"
arch=('x86_64')
url="https://github.com/BlitterStudio/amiberry"
license=('GPL-3.0-or-later')
depends=(
    'sdl3' 'sdl3_image'
    'flac' 'mpg123' 'libmpeg2'
    'libserialport' 'portmidi'
    'enet' 'libpcap' 'tinyxml2'
    'zstd' 'dbus'
    'nlohmann-json' 'curl' 'libpng'
    'hicolor-icon-theme'
)
makedepends=('git' 'cmake' 'ninja')
provides=("amiberry=${pkgver}")
conflicts=('amiberry-git' 'amiberry-lite')
source=("${pkgname}::git+https://github.com/BlitterStudio/amiberry.git#tag=v${pkgver}"
        "0001-cfgfile-atomic-save.patch")
sha256sums=('SKIP'
            'SKIP')
options=('!lto')  # CMake handles LTO via WITH_LTO

prepare() {
    cd "${pkgname}"
    # AmiCachy: prevent 0-byte .uae after Amiberry crash mid-save
    # (BlitterStudio/amiberry#1345). Switches cfgfile_save() to write a
    # temp file, fsync, and rename(2) into place atomically.
    patch -p1 < "${srcdir}/0001-cfgfile-atomic-save.patch"
}

build() {
    cd "${pkgname}"

    # CachyOS makepkg.conf sets CFLAGS="-march=native ..." which silently
    # turns this package into a host-CPU-specific binary: build on a Zen 4
    # host and you get AVX-512 in the .pkg, then SIGILL on every other
    # machine. Override with an explicit target so the resulting .pkg is
    # portable to any CPU at that x86-64 level.
    #
    # AMICACHY_CPU_ARCH_LEVEL is set by tools/build_amiberry.sh; default
    # x86-64-v3 (AVX2 baseline, ~99% of consumer CPUs since 2013-2015).
    local _arch_level="${AMICACHY_CPU_ARCH_LEVEL:-x86-64-v3}"
    local _arch_flags="-march=${_arch_level} -mtune=generic"

    cmake -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_C_FLAGS="${CFLAGS} ${_arch_flags}" \
        -DCMAKE_CXX_FLAGS="${CXXFLAGS} ${_arch_flags}" \
        -DWITH_LTO=OFF \
        -DUSE_OPENGL=ON \
        -DUSE_DBUS=ON \
        -DUSE_ZSTD=ON \
        -DUSE_IPC_SOCKET=ON
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install "${pkgname}/build"
}
