/* SPDX-License-Identifier: CC0-1.0
 *
 * AmiCachy stylesheet — Workbench 3.2.3 look (F3 minimal, polished in F5).
 *
 * Light Workbench gray window background (NOT dark: an earlier dark background
 * made Calamares' default dark text unreadable). #BCBCBC keeps black text
 * perfectly legible while evoking the classic 3.x desktop gray. Input widgets
 * keep their light default, like Workbench string gadgets on a gray panel.
 */

#mainApp {
    background-color: #BCBCBC;
}
